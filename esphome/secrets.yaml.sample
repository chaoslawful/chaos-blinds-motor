# 凭据模板：填入真实值后改名为 secrets.yaml，本文件不应提交到公开仓库（已加入 .gitignore 建议）
# API 加密密钥生成：openssl rand -base64 32
# 或访问 https://esphome.io/ 文档中提供的在线生成器

wifi_ssid: "<AP SSID>"
wifi_password: "<AP password>"

# 回退配网 AP 密码（至少 8 位）
ap_password: "<Fallback AP password>"

# HA API 加密密钥（base64，32 字节）
# OTA 已切换为 Noise 加密（继承此 key），ota_password 不再被引用
api_encryption_key: "<base64 encryption key>"

# Web 控制台鉴权
web_user: "admin"
web_password: "<admin password>"
